<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin/**/*.cs;obj/**/*.cs" />
    <EmbeddedResource Include="../../openasrinput/presentation/branding/logo.ico"
                      LogicalName="OpenASRInput.Logo"
                      Condition="Exists('../../openasrinput/presentation/branding/logo.ico')" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('../../openasrinput/presentation/branding/logo.ico')">
    <ApplicationIcon>../../openasrinput/presentation/branding/logo.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
